# ============================================================
# 复制本文件为 .env，把你自己的值填进去。.env 不会被提交到仓库。
# 每一项的详细说明见 docs/环境变量说明.md
# ============================================================

# ---------- 云端大模型（阿里云百炼 / DashScope，OpenAI 兼容接口）----------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_LINE_NAME=qwen-plus

# ---------- 本地大模型（Ollama，可选；不装就留空，代码会自动走云端）----------
LOCAL_URL=http://localhost:11434/v1
MODEL_LOCAL_NAME=qwen2.5:7b

# ---------- MySQL：订单业务库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=order_customer_service

# ---------- PostgreSQL：LangGraph Checkpointer + 会话摘要 ----------
POSTGRESQL_URL=postgresql://postgres:your_pg_password@localhost:5432/order_customer_service

# ---------- Redis：会话表 / 会话锁 / 窗口记忆 / 用户画像 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---------- ChromaDB：长期偏好记忆 ----------
CHROMA_PATH=./data/chroma_db

# ---------- 向量模型：政策 RAG 用（本地路径，不填则向量检索不可用）----------
EMBEDDING_MODEL_PATH=D:/models/bge-small-zh-v1.5

# ---------- 窗口记忆 ----------
WINDOW_MEMORY_ROUNDS=10
WINDOW_MEMORY_TIME=86400

# ---------- 邮件：登录验证码（可选）----------
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_TO=your_account@qq.com
EMAIL_PASSWORD=your_smtp_authorization_code
